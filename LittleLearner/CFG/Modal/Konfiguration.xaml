<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LittleLearner.CFG.Modal.Konfiguration"
             Title="Konfiguration"
             BackgroundColor="Transparent">
    <AbsoluteLayout>
        <Border AbsoluteLayout.LayoutBounds="0.5,0.5"
                AbsoluteLayout.LayoutFlags="PositionProportional" 
                WidthRequest="400" 
                BackgroundColor="{StaticResource Primary}" 
                Stroke="Black" 
                StrokeShape="RoundRectangle, 16">

            <ScrollView>
                <VerticalStackLayout Spacing="20" Margin="8, 0, 8, 0">
                    <Label Text="Graph Bearbeitungskosten" />
                    <Grid></Grid>
                    
                    <Label Text="Compilereinstellungen" />
                    <Grid></Grid>

                    <Label Text="Vergleichsparameter" />
                    <Slider />
                    <Slider />
                    <Slider />

                    <HorizontalStackLayout>
                        <Button Text="Cancel" Clicked="CancleConfiguratoin" />
                        <Button Text="OK" Clicked="ConfirmConfiguration" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </AbsoluteLayout>
</ContentPage>