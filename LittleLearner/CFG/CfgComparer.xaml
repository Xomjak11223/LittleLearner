<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fc="clr-namespace:LittleLearner.CFG"
             x:Class="LittleLearner.CFG.CfgComparer">

    
    <ContentPage.Resources>
        <fc:FlowchartDrawer x:Key="flowchart" />
    </ContentPage.Resources>
    
    <ContentPage.MenuBarItems>
        <MenuBarItem Text="C-Program">
            <MenuFlyoutItem Text="Import" Clicked="ImportCProgram"/>
            <MenuFlyoutItem Text="Save" Clicked="SaveCProgram"/>
        </MenuBarItem>
        <MenuBarItem Text="CFG">
            <MenuFlyoutItem Text="Import" Clicked="ImportCFG"/>
            <MenuFlyoutItem Text="Save" Clicked="SaveCFG"/>
        </MenuBarItem>
    </ContentPage.MenuBarItems>

    <Grid ColumnDefinitions="*, *">
        <Editor BackgroundColor="#003C64" Grid.Column="0" />

        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">
            <HorizontalStackLayout Grid.Row="0" BackgroundColor="DarkGrey">
                <Button Text="Start" Clicked="temporaryStart" />
                <Button Text="End" Clicked="temporaryEnd" />
                <Button Text="Action" Clicked="temporaryAction" />
                <Button Text="Decision" Clicked="temporaryDecision" />
            </HorizontalStackLayout>
            
            <GraphicsView Drawable="{DynamicResource flowchart}" x:Name="FlowchartView" Grid.Row="1" BackgroundColor="#003C64" />

            <Button Grid.Row="2" Grid.Column="0" HorizontalOptions="Start" Margin="16, 8, 0, 8" Text="Prüfen"/>
            <Button Grid.Row="2" Grid.Column="1" HorizontalOptions="End" Margin="0, 8, 16, 8" Text="Lösung"/>
        </Grid>
    </Grid>
</ContentPage>