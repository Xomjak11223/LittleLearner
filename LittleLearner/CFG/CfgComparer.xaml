<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fc="clr-namespace:LittleLearner.CFG"
             x:Class="LittleLearner.CFG.CfgComparer">

    <ContentPage.Resources>
        <fc:FlowchartDrawer x:Key="flowchart" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Import Code" Order="Primary" Clicked="ImportCProgram"/>
        <ToolbarItem Text="Save Code" Order="Primary" Clicked="SaveCProgram"/>

        <ToolbarItem Text="Import Graph" Order="Primary" Clicked="ImportCFG"/>
        <ToolbarItem Text="Save Graph" Order="Primary"  Clicked="SaveCFG"/>
    </ContentPage.ToolbarItems>

    <Grid ColumnDefinitions="*, *">
        <!-- Editor BackgroundColor="#003C64" Grid.Column="0" /-->
        <WebView Grid.Column="0" x:Name="CodeWebView" Navigating="CodeWritten">
            <WebView.Source>
                <HtmlWebViewSource x:Name="CodeSection" Html="&lt;span style='font-weight:bold;color:#a71d5d;'&gt;int&lt;/span&gt;" />
            </WebView.Source>
        </WebView>

        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">
            <HorizontalStackLayout Grid.Row="0" Spacing="8" Padding="2">
                <Button Text="Move" Clicked="Move" />
                <Button Text="Scale" Clicked="Scale" />
                <Button Text="Select" Clicked="Select" />
                <Button Text="Add" Clicked="Add" />
                <Button Text="Connect" Clicked="Connect" />
                <Button Text="Edit" Clicked="Edit" />
            </HorizontalStackLayout>
            
            <GraphicsView Drawable="{DynamicResource flowchart}" x:Name="FlowchartView" Grid.Row="1" BackgroundColor="#003C64" />

            <Button Grid.Row="2" Grid.Column="0" HorizontalOptions="Start" Margin="16, 8, 0, 8" Text="Prüfen"/>
            <Button Grid.Row="2" Grid.Column="1" HorizontalOptions="End" Margin="0, 8, 16, 8" Text="Lösung"/>
        </Grid>
    </Grid>
</ContentPage>