<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LittleLearner.LCS.LimitCSolver"
             xmlns:Lables="clr-namespace:LittleLearner.LCS"
             x:DataType="Lables:Protocol">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Auto Generate Code" Clicked="GenerateCodeC"/>
        <ToolbarItem Text="Import Code" Clicked="ImportCProgram"/>

        <ToolbarItem Text="Save Code" Clicked="SaveCProgram"/>

        <ToolbarItem Text="Import Graph" Clicked="ImportLables"/>
        <ToolbarItem Text="Sync" Order="Secondary" Clicked="Sync"/>
        <ToolbarItem Text="Show Color Mapping" Order="Secondary" Clicked="OpenModalColorMapping"/>
        <ToolbarItem Text="Code Generation Settings" Order="Secondary" Clicked="OpenModalCodeSettings"/>
    </ContentPage.ToolbarItems>

    <Grid ColumnDefinitions="*, *">
        <!--Code-->
        <AbsoluteLayout>
            <WebView AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All" x:Name="CodeWebViewLCS" Source="CodeEditorAutoUpdate.html" />
            <ImageButton Source="appicon.png" Margin="0, 12, 12, 0" Clicked="ToggleCodeCreator" AbsoluteLayout.LayoutBounds="1, 0" AbsoluteLayout.LayoutFlags="PositionProportional" />
            
            <!--Automatic Code Generation-->
            <VerticalStackLayout x:Name="CodeCreator" Margin="0, 12, 12, 0" Padding="8" IsVisible="False" BackgroundColor="Purple" AbsoluteLayout.LayoutBounds="1, 0" AbsoluteLayout.LayoutFlags="PositionProportional" Spacing="8">
                <ImageButton Source="appicon.png" Clicked="ToggleCodeCreator" />
                <HorizontalStackLayout>
                    <Label Text="Difficulty" />

                    <Border x:Name="DifficultyEasy" BackgroundColor="Purple" Stroke="Black" Margin="4, 0, 4, 0">
                        <Label Text="Easy" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SelectDifficulty"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Border x:Name="DifficultyMedium"  BackgroundColor="Purple" Stroke="Black" Margin="4, 0, 4, 0">
                        <Label Text="Medium" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SelectDifficulty"/>
                        </Border.GestureRecognizers>
                    </Border>
                    <Border x:Name="DifficultyHard" BackgroundColor="Purple" Stroke="Black" Margin="4, 0, 0, 0">
                        <Label Text="Hard" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SelectDifficulty"/>
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Rechenoperationen" />
                </HorizontalStackLayout>


                <Grid>
                    <CheckBox />
                    
                </Grid>

                <Button Text="Generate" Clicked="AutomaticCreateCode" />
            </VerticalStackLayout>
        </AbsoluteLayout>

        <!--Lables-->
        <Grid Grid.Column="1" RowDefinitions="*, Auto" x:Name="LabelGrid">
            <Button Grid.Row="1" Grid.Column="0" HorizontalOptions="Start" Text="Prüfen" Clicked="CompareSolutions"/>
            <Button Grid.Row="1" Grid.Column="1" HorizontalOptions="End" Text="Lösung"/>

            <Grid Grid.Row="0"></Grid>
        </Grid>
    </Grid>
</ContentPage>