<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LCS_FillProtocol.MainPage"
             Title="Protokolleingabe">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Import" Clicked="ImportProtocol"/>
        <ToolbarItem Text="Export" Clicked="ExportProtocol"/>
    </ContentPage.ToolbarItems>

    <Grid ColumnDefinitions="*, *">
        <Border Grid.Column="0">
            <HybridWebView x:Name="CodeWebView" DefaultFile="CodeEditor.html" />
        </Border>
        <Border Grid.Column="1">
            <Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
